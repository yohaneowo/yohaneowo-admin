# yohaneowo-admin NAS 部署的环境变量。复制成 .env，和 compose.yaml 放在同一个文件夹。
# 密钥都用 openssl rand -hex 32 之类的方法随机生成，不要沿用开发环境的值。

# 网页端口：http://<NAS 的 IP>:18090/web（不要用 80/443/5000/5001，那些 DSM 自己在用）
WEB_PORT=18090

# 镜像 tag，默认 latest；要固定版本可填 publish.sh 输出的 git 版本号
IMAGE_TAG=latest

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=

# 只读账号 readonly 的密码（DBeaver 浏览数据用，只能 SELECT）。留空 = 不建立
MYSQL_READONLY_PASSWORD=
# DBeaver 经 SSH 隧道连 MySQL 用的 NAS 本机端口（只绑 127.0.0.1，局域网连不进来）
MYSQL_TUNNEL_PORT=13306

# 每天自动备份的时间与保留天数，备份在本文件夹下的 backup/
BACKUP_TIME=04:00
BACKUP_KEEP_DAYS=30





# 页面显示时间用的时区，默认 Asia/Taipei（数据库一律存 UTC）
# DISPLAY_TIMEZONE=Asia/Taipei

# 允许的 Host 头（JSON 数组）。只在家里用时可以不设（默认 ["*"]）。
# 以后通过 Cloudflare Tunnel 对外时改成实际网址，例如：
# ALLOWED_HOSTS=["admin.yohaneowo.com","192.168.0.100","yohaneowo-admin-web"]

# Doppler（项目 yohaneowo-admin、配置 prd）的 service token：Doppler 后台 → 项目 → prd → Access 建立。
# backend 启动时用它取 SECRET_KEY、BOT_API_TOKEN、OMDB_API_KEY、ANTHROPIC_ADMIN_API_KEY 等应用密钥
DOPPLER_TOKEN=
